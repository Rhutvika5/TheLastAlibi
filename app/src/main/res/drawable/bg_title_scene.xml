
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark antique brown radial background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="750dp"
                android:centerX="50%"
                android:centerY="43%"
                android:startColor="#382015"
                android:centerColor="#17100B"
                android:endColor="#050403" />
        </shape>
    </item>

    <!-- Dark edges and cinematic vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#99000000"
                android:centerColor="#11000000"
                android:endColor="#CC000000" />
        </shape>
    </item>

</layer-list>
