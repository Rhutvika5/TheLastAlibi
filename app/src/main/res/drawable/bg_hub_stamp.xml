
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#25A3322D"/>
            <stroke
                android:width="2dp"
                android:color="#A3322D"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>

    <item
        android:left="4dp"
        android:top="3dp"
        android:right="4dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF"/>
            <stroke
                android:width="1dp"
                android:color="#66A3322D"/>
            <corners android:radius="1dp"/>
        </shape>

    </item>

</layer-list>
