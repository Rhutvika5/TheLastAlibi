
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_title_scene">

    <!-- LEFT CORNER: MAGNIFYING GLASS -->
    <ImageView
        android:id="@+id/magnifyingGlassDecor"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="28dp"
        android:src="@drawable/ic_magnifying_glass"
        android:alpha="0.22"
        android:rotation="-12"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- RIGHT CORNER: DETECTIVE OUTLINE -->
    <ImageView
        android:id="@+id/detectiveDecor"
        android:layout_width="180dp"
        android:layout_height="220dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="24dp"
        android:src="@drawable/ic_detective_outline"
        android:alpha="0.18"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#C43A32"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="THE LAST ALIBI"
            android:textColor="#E8D5B5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_title_card"
            android:text="CASE #409"
            android:textColor="#C99A55"
            android:textSize="10sp"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/audioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="♪ AUDIO OFF"
            android:textColor="#C9B99F"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="MAIN MENU"
            android:textColor="#C9B99F"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- CENTRE TITLE -->
    <LinearLayout
        android:id="@+id/titleSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- RED TILTED STAMP -->
        <TextView
            android:id="@+id/divisionStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="-5"
            android:background="@drawable/bg_title_stamp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="7dp"
            android:text="GREYWOOD PD DIVISION"
            android:textColor="#C94A43"
            android:textSize="13sp"
            android:fontFamily="@font/special_elite"
            android:letterSpacing="0.09"
            android:gravity="center" />

        <!-- MAIN TITLE -->
        <TextView
            android:id="@+id/gameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="THE LAST ALIBI"
            android:textColor="#EFA11A"
            android:textSize="43sp"
            android:textStyle="bold"
            android:fontFamily="@font/special_elite"
            android:gravity="center"
            android:letterSpacing="0.04" />

        <!-- SUBTITLE -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Detective Mystery Game — C++ Engine Connected"
            android:textColor="#B9A58C"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- BOTTOM LEFT AND RIGHT BUTTONS -->
    <LinearLayout
        android:id="@+id/homeButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- LEFT: START INVESTIGATION -->
        <Button
            android:id="@+id/startButton"
            android:layout_width="195dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button"
            android:text="START INVESTIGATION"
            android:textColor="#17100B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.04"
            android:padding="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- RIGHT: HOW TO PLAY -->
        <Button
            android:id="@+id/howToPlayButton"
            android:layout_width="195dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="HOW TO PLAY / MANUAL"
            android:textColor="#D5B98C"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:padding="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

    </LinearLayout>

</FrameLayout>
