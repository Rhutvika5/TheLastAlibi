
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_noir_office">

    <!-- LEFT CORNER: MAGNIFYING GLASS -->
    <ImageView
        android:id="@+id/magnifyingGlassDecor"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="28dp"
        android:src="@drawable/ic_magnifying_glass"
        android:alpha="0.22"
        android:rotation="-12"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- RIGHT CORNER: DETECTIVE OUTLINE -->
    <ImageView
        android:id="@+id/detectiveDecor"
        android:layout_width="180dp"
        android:layout_height="220dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="24dp"
        android:src="@drawable/ic_detective_outline"
        android:alpha="0.18"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#C43A32"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="THE LAST ALIBI"
            android:textColor="#E8D5B5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_title_card"
            android:text="CASE #409"
            android:textColor="#C99A55"
            android:textSize="10sp"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/audioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="🔊"
            android:textColor="#C9B99F"
            android:textSize="18sp"
            android:gravity="center"
            android:contentDescription="Toggle audio" />

        <TextView
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="MAIN MENU"
            android:textColor="#C9B99F"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- CENTRE TITLE AND ACTIONS -->
    <LinearLayout
        android:id="@+id/titleSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THE"
            android:textColor="#E8D5B5"
            android:textSize="23sp"
            android:textStyle="bold|italic"
            android:fontFamily="@font/special_elite"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LAST"
                android:textColor="#E8D5B5"
                android:textSize="57sp"
                android:textStyle="bold|italic"
                android:fontFamily="@font/special_elite"
                android:letterSpacing="0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="ALIBI"
                android:textColor="#B52C2A"
                android:textSize="57sp"
                android:textStyle="bold|italic"
                android:fontFamily="@font/special_elite"
                android:letterSpacing="0.01" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:background="#9C7B52" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Detective Mystery Game  —  C++ Engine Connected"
                android:textColor="#C6B9A5"
                android:textSize="12sp"
                android:fontFamily="@font/special_elite"
                android:gravity="center" />

            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:background="#9C7B52" />
        </LinearLayout>

        <Button
            android:id="@+id/startButton"
            android:layout_width="320dp"
            android:layout_height="64dp"
            android:layout_marginTop="29dp"
            android:background="@drawable/bg_title_primary_button"
            android:text="⌕   START INVESTIGATION   ›"
            android:textColor="#E7C38E"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.025"
            android:padding="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/howToPlayButton"
            android:layout_width="270dp"
            android:layout_height="48dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="▤   HOW TO PLAY / MANUAL   ›"
            android:textColor="#D5B98C"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:padding="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

    </LinearLayout>

    <!-- CASE STATUS AND TAGLINE -->
    <LinearLayout
        android:id="@+id/homeButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:background="@drawable/bg_title_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASE STATUS"
                android:textColor="#B9A58C"
                android:textSize="9sp"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="●  IN PROGRESS"
                android:textColor="#70A36B"
                android:textSize="11sp"
                android:fontFamily="@font/special_elite" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="SOLVE   ·   INVESTIGATE   ·   UNCOVER"
            android:textColor="#A9977D"
            android:textSize="9sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

</FrameLayout>
