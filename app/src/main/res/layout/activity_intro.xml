
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_noir_office">

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:background="#D90A0908">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#9679;"
            android:textColor="#C43A32"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="THE LAST ALIBI"
            android:textColor="#E8D5B5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/special_elite"
            android:letterSpacing="0.10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_title_card"
            android:text="CASE #409"
            android:textColor="#C99A55"
            android:textSize="10sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/audioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="♪ AUDIO OFF"
            android:textColor="#C9B99F"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_title_secondary_button"
            android:text="BACK TO CASES"
            android:textColor="#C9B99F"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- MAIN CINEMATIC CONTENT -->
    <LinearLayout
        android:id="@+id/prologueContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="62dp"
        android:layout_marginBottom="15dp"
        android:orientation="vertical">

        

        <!-- STORY PANEL -->
        <LinearLayout
            android:id="@+id/storyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_title_card"
            android:padding="12dp">

            <!-- HIDDEN HEADINGS -->
            <TextView
                android:id="@+id/introTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROLOGUE"
                android:visibility="gone" />

            <TextView
                android:id="@+id/introSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCENE 1 / 6"
                android:visibility="gone" />

            <!-- CINEMATIC IMAGE -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2.5"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/sceneImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/scene_01_forgotten_town"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Cinematic story scene" />

                <!-- BOTH BUTTONS OVER IMAGE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="#990A0908">

                    <Button
                        android:id="@+id/skipButton"
                        android:layout_width="135dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_title_secondary_button"
                        android:text="SKIP TYPING"
                        android:textColor="#D5B98C"
                        android:textSize="10sp"
                        android:textAllCaps="false"
                        android:fontFamily="@font/special_elite"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/beginButton"
                        android:layout_width="195dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_button"
                        android:text="NEXT →"
                        android:textColor="#17100B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:fontFamily="@font/special_elite"
                        android:enabled="false"
                        android:alpha="0.45"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                </LinearLayout>

            </FrameLayout>

            <!-- STORY PARAGRAPH BELOW IMAGE -->
            <ScrollView
                android:id="@+id/storyScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.5"
                android:background="@drawable/bg_glass_panel"
                android:padding="14dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/storyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#E8DCC7"
                    android:textSize="15sp"
                    android:fontFamily="@font/special_elite"
                    android:lineSpacingExtra="8dp"
                    android:letterSpacing="0.015"
                    android:paddingBottom="12dp"
                    android:gravity="start"
                    android:includeFontPadding="true" />

            </ScrollView>

        </LinearLayout>


        <!-- NARRATOR PANEL HIDDEN, VOICE CODE PRESERVED -->
        <LinearLayout
            android:id="@+id/narratorPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/narratorImage"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:src="@drawable/ic_narrator_portrait"
                android:contentDescription="Narrator" />

            <TextView
                android:id="@+id/narratorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● NARRATING..." />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
