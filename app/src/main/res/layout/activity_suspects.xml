
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/suspectsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#211911">

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:background="#0D0C0A">

        <!-- BACK BUTTON - LEFT CORNER -->
        <TextView
            android:id="@+id/menuButton"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_hub_header_button"
            android:gravity="center"
            android:padding="0dp"
            android:text="↩"
            android:textColor="#D6B98A"
            android:textSize="21sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#96352C"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="SUSPECT BOARD"
            android:textColor="#E8C78F"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="@font/special_elite"
            android:letterSpacing="0.07" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_hub_case_label"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="PERSONS OF INTEREST"
            android:textColor="#CB8176"
            android:textSize="9sp"
            android:fontFamily="@font/special_elite" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- SINGLE AUDIO CONTROL -->
        <TextView
            android:id="@+id/audioButton"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_hub_header_button"
            android:gravity="center"
            android:padding="0dp"
            android:text="🔊"
            android:textColor="#D6B98A"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- HEADER DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="56dp"
        android:background="#795336" />

    <!-- SCROLLABLE INVESTIGATION BOARD -->
    <ScrollView
        android:id="@+id/suspectScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="57dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:background="@drawable/bg_suspect_corkboard">

        <FrameLayout
            android:id="@+id/boardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_suspect_corkboard"
            android:clipChildren="false"
            android:clipToPadding="false" />

    </ScrollView>

</FrameLayout>
