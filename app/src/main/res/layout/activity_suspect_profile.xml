
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_noir_office"
    android:clipChildren="false">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:background="#D90A0908">

        <!-- BACK BUTTON - LEFT CORNER -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_hub_header_button"
            android:gravity="center"
            android:padding="0dp"
            android:text="↩"
            android:textColor="#D6B98A"
            android:textSize="21sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#96352C"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DR. MIRA"
                android:textColor="#E8C78F"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/special_elite" />

            <TextView
                android:id="@+id/profileRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOWN DOCTOR"
                android:textColor="#AE9674"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- HEADER DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="56dp"
        android:background="#795336" />

    <!-- MAIN SPLIT SCREEN -->
    <LinearLayout
        android:id="@+id/profileMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="54dp"
        android:layout_marginEnd="20dp">

        <!-- LEFT: DIALOGUE AND CHARACTER -->
        <LinearLayout
            android:id="@+id/characterPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95"
            android:layout_marginEnd="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="7dp"
            android:background="@drawable/bg_profile_panel">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.05"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:id="@+id/characterContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false" />

                <TextView
                    android:id="@+id/characterCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TOWN DOCTOR"
                    android:textColor="#D5B47C"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:fontFamily="@font/special_elite"
                    android:paddingBottom="5dp" />
            </LinearLayout>

            <!-- DIALOGUE BOX -->
            <LinearLayout
                android:id="@+id/dialogueBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.95"
                android:layout_marginStart="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="11dp"
                android:background="@drawable/bg_profile_dialogue">

                <TextView
                    android:id="@+id/dialogueLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dialoguePrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/dialogueText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="At home during the night."
                        android:textColor="#39291D"
                        android:textSize="16sp"
                        android:fontFamily="serif"
                        android:textStyle="italic"
                        android:lineSpacingExtra="5dp" />

                </ScrollView>

            </LinearLayout>

        </LinearLayout>

        <!-- RIGHT: QUESTIONS -->
        <LinearLayout
            android:id="@+id/questionsPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:layout_marginStart="7dp"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@drawable/bg_profile_panel">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUESTION THE SUSPECT"
                android:textColor="#E0B46C"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/special_elite" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Choose a question to hear their response."
                android:textColor="#A9997C"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="#705538" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/questionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GREYWOOD POLICE DEPARTMENT"
                android:textColor="#8C7657"
                android:textSize="9sp"
                android:gravity="center"
                android:paddingTop="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- READ STATEMENT TAB -->
    <TextView
        android:id="@+id/statementTab"
        android:layout_width="62dp"
        android:layout_height="116dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/bg_case_tab"
        android:elevation="8dp"
        android:gravity="center"
        android:padding="5dp"
        android:text="READ&#10;STATEMENT&#10;›"
        android:textColor="#513A23"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="@font/special_elite"
        android:clickable="true"
        android:focusable="true" />

    <!-- STATEMENT SCRIM -->
    <View
        android:id="@+id/statementScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- STATEMENT DRAWER -->
    <LinearLayout
        android:id="@+id/statementDrawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_hub_paper"
        android:elevation="15dp"
        android:translationX="-320dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HER STATEMENT"
                android:textColor="#302419"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="@font/special_elite" />

            <TextView
                android:id="@+id/closeStatementButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_hub_header_button"
                android:gravity="center"
                android:text="✕"
                android:textColor="#D6B98A"
                android:textSize="17sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="OFFICIAL SUSPECT STATEMENT"
            android:textColor="#963D32"
            android:textSize="10sp"
            android:fontFamily="@font/special_elite" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="#735638" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <TextView
                android:id="@+id/actualStatementText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading statement..."
                android:textColor="#3D3022"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:textStyle="italic"
                android:lineSpacingExtra="6dp"
                android:padding="5dp" />

        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#8B714D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="GREYWOOD POLICE DEPARTMENT"
            android:textColor="#765638"
            android:textSize="9sp"
            android:fontFamily="@font/special_elite"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
